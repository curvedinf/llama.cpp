#version 450

#extension GL_EXT_control_flow_attributes : require

layout(constant_id = 0) const uint BLOCK_SIZE = 256;
layout(constant_id = 1) const uint ACTIVATION = 0; // 0 = silu, 1 = sigmoid

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// fused: dst[i] = x[i] * act(z[i])

layout(binding = 0) readonly  buffer XBuf { float data_x[]; };
layout(binding = 1) readonly  buffer ZBuf { float data_z[]; };
layout(binding = 2)           buffer Dst  { float data_d[]; };

layout(push_constant) uniform PushConstants {
    uint ne;
} pc;

void main() {
    const uint idx = gl_GlobalInvocationID.x;

    if (idx >= pc.ne) {
        return;
    }

    const float z = data_z[idx];

    float act;
    if (ACTIVATION == 1) {
        act = 1.0f / (1.0f + exp(-z));
    } else {
        act = z / (1.0f + exp(-z));
    }

    data_d[idx] = data_x[idx] * act;
}
